      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Your googlePalmApi"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "fbba2996-b562-40dc-930c-a7580829a66e",
              "leftValue": "={{ $json.output }}",
              "rightValue": "SHORTLISTED",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "id": "bce73c77-80f5-4eb1-869c-1c5d911be941",
      "name": "If"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Gmail Trigger').item.json.from.value[0].address }}",
        "subject": "Application Update - Digital Marketing Executive",
        "emailType": "text",
        "message": "=Dear {{ $('AI Agent').item.json.output.match(/Name: (.+)/)[1] }},  Thank you for applying for the Digital Marketing Executive position. We are pleased to inform you that your profile has been shortlisted for the next stage.  Our team will contact you shortly with further details.  Best regards, Hiring Team",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        928,
        -96
      ],
      "id": "0712d127-0ac8-4c18-8b37-819a26d307bc",
