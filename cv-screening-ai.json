    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "You are an HR assistant screening CVs for a Digital Marketing Executive position.\n\nRequired skills: social media management, content writing, basic communication skills.\nExperience: Freshers welcome (0-1 years), more experience is a bonus.\n\nRead the CV text provided and respond ONLY in this exact format:\nName: [candidate's name from CV]\nStatus: SHORTLISTED or REJECTED\nReason: [1-2 sentence reason based on skills/experience match]"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        304,
        0
      ],
      "id": "cd45f649-0fa6-4401-8d98-540a7c2ce3f2",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
