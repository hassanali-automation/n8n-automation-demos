      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Your googleSheetsOAuth2Api"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $('Gmail Trigger').item.json.from.value[0].address }}",
        "subject": "Application Update - Digital Marketing Executive",
        "message": "=Dear {{ $('AI Agent').item.json.output.match(/Name: (.+)/)[1] }},  Thank you for applying for the Digital Marketing Executive position and for taking the time to share your profile with us.  After careful review, we have decided to move forward with other candidates whose experience more closely matches our current requirements. We appreciate your interest and encourage you to apply for future openings that match your skills.  Best regards, Hiring Team",
        "options": {}
